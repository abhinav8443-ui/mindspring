# MindSpring Environment Configuration
PORT=5000
NODE_ENV=development

# AI API Key (Optional)
# If provided, MindSpring connects to Google Gemini 1.5/2.0 Flash for enhanced natural language dialogue.
# If omitted or set to demo_key, MindSpring seamlessly runs its high-performance offline empathetic companion engine.
GEMINI_API_KEY=

# Database Connection (Optional - defaults to in-memory store for quick demo)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mindspring

# Session Secret (Optional)
SESSION_SECRET=mindspring_super_secret_dev_key_2027
